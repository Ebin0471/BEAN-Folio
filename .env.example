# BEAN Folio — environment reference (copy values into your host's env settings; never commit real secrets)

# ── Required in every environment ────────────────────────────────────────────
# Local sandbox / self-host with SQLite:
DATABASE_URL="file:./db/custom.db"
# Production (Vercel etc.): a managed PostgreSQL connection string instead, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/beanfolio?sslmode=require"
# Vercel log shows "Authentication failed … credentials for postgres are not
# valid" (Prisma P1000)? Never hand-type the URL — copy the CURRENT string from
# your provider's dashboard and see docs/deployment.md §0.4 for the exact steps.

# ── Production public URL (required in the deployed Production environment) ──
# The exact HTTPS origin of the real deployment — this is the ONLY source of the
# permanent public portfolio URL (publish dialog, Copy Link, Share, SEO metadata).
# Must be HTTPS, no trailing slash, and must not be an internal/preview host.
# On Vercel: set to your production domain, e.g. "https://bean-folio.vercel.app"
# (the stable domain Vercel assigns) or your custom domain. NEXT_PUBLIC_ vars are
# inlined at BUILD time — set this BEFORE deploying, or redeploy after changing it.
# NEXT_PUBLIC_APP_URL="https://your-production-domain"

# ── Auto-set by Vercel (do not configure manually) ───────────────────────────
# VERCEL_URL / VERCEL_ENV / VERCEL_PROJECT_PRODUCTION_URL — used as a fallback
# share origin by src/lib/site-url.ts when NEXT_PUBLIC_APP_URL is absent.

# ── Reserved for planned integrations (see docs/deployment.md §3.2) ──────────
SESSION_SECURE_COOKIES=                 # optional explicit secure-cookie override (true|false; unknown values are rejected at startup)
# BEAN_ALLOW_INSECURE_COOKIES — the ONLY way to run with SESSION_SECURE_COOKIES=false
# in production (plain-HTTP LAN deployments). Without it, production startup fails
# fast rather than issuing non-Secure session cookies (src/lib/startup-validation.ts).

# ── Durable background queue (src/lib/queue/ — IMPLEMENTED) ───────────────────
# In-process worker starts by default; disable on instances whose only job is
# serving HTTP and run `bun scripts/queue-drain.ts` on dedicated workers instead.
QUEUE_ENABLED=true                      # false disables the in-process worker entirely
QUEUE_POLL_MS=2000                      # worker claim poll interval
QUEUE_CONCURRENCY=4                     # global in-flight job cap per worker
QUEUE_USER_CONCURRENCY=2                # per-user in-flight cap (one user can't hog the queue)

# ── Shared rate-limit backend (src/lib/rate-limit-backend.ts — IMPLEMENTED) ───
# Default "memory" is per-instance (fine for one box; silently per-instance at
# >1 replica). "postgres" shares abuse-sensitive buckets through RateLimitBucket
# rows so limits hold across horizontally scaled instances (see docs/ops/RUNBOOK.md).
RATE_LIMIT_BACKEND=memory               # memory | postgres

# ── Shared cache backend (src/lib/cache/ — IMPLEMENTED, P1) ───────────────────
# Default "memory" is per-instance. "postgres" shares viewer-independent PUBLIC
# cache entries (published profiles, profession taxonomy) through CacheEntry
# rows + CacheGeneration counters so every instance reads the same data and
# cross-instance invalidation converges within ~1s (no message broker needed).
# SAFETY: only whitelisted PUBLIC key namespaces may enter the shared store —
# private/per-viewer data is refused at the write boundary (src/lib/cache/shared.ts).
# In production set BOTH this and RATE_LIMIT_BACKEND=postgres when running >1
# instance (same DATABASE_URL; no extra service).
CACHE_BACKEND=memory                    # memory | postgres

# ── Media / object storage (src/lib/storage.ts — IMPLEMENTED) ─────────────────
# Two drivers behind one API. Leave everything unset for local-disk storage
# (sandbox / self-hosted single instance: files under <cwd>/uploads).
# On stateless production hosts (Vercel etc.) you MUST configure S3-compatible
# object storage — the local filesystem there is EPHEMERAL and uploads would be
# lost on every redeploy. Works with AWS S3, Cloudflare R2, Supabase Storage
# (S3-compatible endpoint), MinIO, … All four S3_* vars are required together.
# S3_ENDPOINT=                          # e.g. https://s3.amazonaws.com | https://<project>.supabase.co/storage/v1/s3 | https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=                            # private bucket (media is served only through /api/media/:id/raw)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=                            # optional; defaults to "auto"
# S3_FORCE_PATH_STYLE=false             # optional; path-style (default) is correct for R2/Supabase/MinIO, AWS uses virtual-hosted
# MEDIA_STORAGE_DRIVER=local            # optional override; "local" forces local disk even with S3 vars set
# MEDIA_LOCAL_ROOT=/path/to/root        # optional; base dir containing uploads/ for the local driver (testing/self-host)
# NOTE (serverless upload size): SOLVED for S3 deployments — the client uses
# PRESIGNED DIRECT uploads (POST /api/media/direct/presign → browser PUTs the
# bytes straight to the bucket → POST /api/media/direct/complete verifies
# content). File contents never pass through a Next.js handler, so the ~4.5 MB
# function body cap no longer bounds upload size (docs/media-pipeline.md §6).
# Local-disk deployments keep the classic multipart upload (route returns 501
# on /api/media/direct/*, the client falls back transparently).

# ── Google OAuth (IMPLEMENTED — direct OIDC, see docs/google-auth.md) ─────────
# "Continue with Google" activates ONLY when BOTH credentials are present.
# Never commit real values; set them in your host's secret store.
GOOGLE_CLIENT_ID=                       # from Google Cloud Console (OAuth 2.0 Client, Web application)
GOOGLE_CLIENT_SECRET=                   # SERVER-ONLY — never in the client bundle, never in git
# Exact callback the server sends to Google. MUST byte-match an Authorized
# redirect URI in Google Cloud Console. Production: https://bean-folio.vercel.app/api/auth/google/callback
# Local dev: http://localhost:3000/api/auth/google/callback (auto-derived from
# the request origin when unset — set it explicitly in production).
GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_SUPABASE_URL=               # NOT USED — reserved placeholder, BEAN Folio does not use Supabase
SUPABASE_SERVICE_ROLE_KEY=              # NOT USED — reserved placeholder, BEAN Folio does not use Supabase
AI_PROVIDER_API_KEY=                    # HISTORICAL — no code reads this today; provider config is gateway-managed (docs/ai-integration.md §9)

# ── BEAN Intelligence gateway (src/lib/intelligence/) ─────────────────────────
# Central provider registry / routing / health for all AI features. Provider
# and model selection are SERVER-ONLY; user-facing UI shows BEAN product
# identities (RIISHE / LAXII / Code Giftz), never provider brands.
BEAN_TEXT_PROVIDER_PRIMARY=             # optional: pin the primary text provider id (default: bean-managed)
INTELLIGENCE_DAILY_COST_LIMIT_USD=5    # per-user daily budget of DOCUMENTED cost estimates for metered image engines (guardrail, not a bill)

# ── LAXII — conversational AI image studio (src/lib/laxii/) ──────────────────
# Provider selection. All image generation goes through the provider-agnostic
# engine; keys are SERVER-ONLY (never exposed to the browser or API responses).
# "managed" is the built-in gateway (always available, no key needed).
LAXII_DEFAULT_PROVIDER=managed          # LAXII V1 engine = managed gateway (fixed; other ids are internal only and are refused for user requests)
# Google Nano Banana (official Gemini API — POST /v1beta/interactions, with
# native multi-turn continuation via previous_interaction_id).
# Leave GEMINI_API_KEY empty to keep the provider disabled; the studio then
# offers only the engines that are actually configured.
GEMINI_API_KEY=
LAXII_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1   # or gemini-3.1-flash-image | gemini-3-pro-image
# OpenAI Images (optional; multipart edits with up to 16 input images).
OPENAI_API_KEY=
LAXII_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   # or gpt-image-1 | gpt-image-1-mini | gpt-image-2.5-flare
# Local Diffusers (OPTIONAL privacy engine — your own hardware, images never
# leave the machine). Point LAXII_DIFFUSERS_URL at a small inference server
# implementing: GET /health → {"status":"ok"} and
# POST /generate {prompt, negative_prompt?, width, height, num_images, steps?,
# guidance_scale?, init_image? (data URL), strength?} → {images:[{base64}]}.
# Leave unset to keep the provider disabled (the default — managed still works).
LAXII_DIFFUSERS_URL=
LAXII_DIFFUSERS_MODEL=local-diffusers
LAXII_DIFFUSERS_TOKEN=                  # optional bearer token for the local server
LAXII_DIFFUSERS_NEGATIVE=               # optional default negative prompt

# ── Operational logging & alerting (src/lib/logger.ts, src/lib/monitoring.ts) ─
# LOG_LEVEL gates the structured JSON logger's verbosity (warn/error go to
# stderr, info/debug to stdout). Unknown values are rejected at startup.
LOG_LEVEL=                              # debug | info | warn | error (default: info in production, debug otherwise)
# ERROR_WEBHOOK_URL — optional webhook endpoint (e.g. Slack/Discord/Alertmanager
# gateway). When set, reportError() posts a redacted, value-free payload on
# API failures, dead-lettered queue jobs and deploy failures. Leave unset to
# disable alerting (fully supported — the hook is a no-op without it).
ERROR_WEBHOOK_URL=

# ── CODE GIFTZ workspace root (src/lib/giftz/workspace.ts) ───────────────────
# Root directory for sandboxed per-site code workspaces. Defaults to
# <cwd>/data/giftz-workspaces. Runtime data (never committed).
CODE_GIFTZ_WORKSPACE_ROOT=

# ── LAXII banner pipeline tuning (src/lib/laxii/banner-pipeline.ts) ──────────
LAXII_AI_VISUAL_REVIEW=                 # enable the AI visual review pass for generated banners
LAXII_BANNER_MAX_ATTEMPTS=              # max generation attempts per banner (integer, default per module)

# ── Email verification (M31 — src/lib/email/delivery.ts, src/lib/email-verification.ts) ──
# Delivery adapter. `none` (default) = no provider configured; the platform
# honestly reports non-delivery and never pretends an email was sent.
# `console` is a development/test-only logging adapter (refused in production).
# A real provider (SMTP/Resend/SES) is an owner decision — none configured.
EMAIL_DELIVERY_ADAPTER=none
# Development/QA-only verification path: 1 exposes verification tokens in API
# responses so QA can complete verification without a provider. FORBIDDEN in
# production (startup validation fails fast).
EMAIL_DEV_TEST_MODE=
