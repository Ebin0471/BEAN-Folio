// BEAN Folio — PostgreSQL target schema (Phase A: zero-app-change mirror)
//
// FULLY REGENERATED 2026-11-14 (M22 Phase 2, owner-approved O2) from
// prisma/schema.prisma — the mirror had drifted 31 models behind (51 vs 82)
// and is now byte-for-byte the same data model (85 models including the
// restored Portfolio / PortfolioRevision / DesignChatMessage), with only the
// datasource provider switched. Identical models = identical generated
// client surface, so application code, zod schemas and ETL run unchanged
// against PostgreSQL. The Vercel build generates from this file
// (package.json vercel-build). Verified by scripts/check-schema-parity.ts.
//
// Usage (only on a host with a real PostgreSQL instance):
//   1. Set DATABASE_URL=postgresql://user:pass@host:5432/beanfolio
//   2. bunx prisma generate --schema prisma/schema.postgres.prisma
//   3. bunx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.postgres.prisma --script > pg-migration/01_schema.sql
//   4. Apply 01_schema.sql, then run scripts/migrate-to-postgres.ts (import),
//      then scripts/verify-postgres-migration.ts.
//
// Phase B (AFTER cutover, separate change — see docs/database.md §6): switch
// status/visibility/kind/type/role String columns to native Prisma `enum` blocks,
// `tools` → String[], `Notification.payload` / `AuditEvent.meta` → Json, and add
// tsvector/GIN search columns. Each of those changes the generated client surface,
// so they deliberately do NOT ship in the same change as the engine swap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Production connection budget (P4 reliability — exhaustion posture):
  // append the pool arguments to DATABASE_URL as query parameters, e.g.
  //   postgresql://user:pass@host:5432/beanfolio?connection_limit=10&pool_timeout=10
  // (they are URL arguments, NOT datasource-block properties — Prisma
  // rejects them as block fields). Each Next instance opens `connection_limit`
  // Postgres connections. The TOTAL across all instances + workers must stay
  // under the database's max_connections (managed providers cap it: e.g.
  // Supabase small ≈ 60 on the direct port, far more via their pooled port).
  // RULE OF THUMB: connection_limit = floor(max_connections * 0.8 /
  // instance_count) — and ALWAYS deploy against a pooler (pgBouncer /
  // provider pooler) at more than ~2 instances — docs/ops/DEPLOYMENT_TIERS.md.
  // Under exhaustion Prisma queues queries with `pool_timeout` (default 10s)
  // and then fails the request — the queue worker and rate limiter degrade
  // per design (docs/ops/RUNBOOK.md §DB saturation) instead of cascading.
  url = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  username          String?   @unique
  headline          String?
  bio               String?
  location          String?
  avatarMediaId     String?
  coverMediaId      String?
  coverPositionY    Int       @default(50) // cover focal point: object-position Y in %
  avatarFit         String    @default("cover") // cover | contain
  avatarZoom        Int       @default(100) // avatar zoom in % (contain mode)
  avatarPosX        Int       @default(50) // avatar focal X in %
  avatarPosY        Int       @default(50) // avatar focal Y in %
  availability      String? // e.g. "Open to opportunities"
  experienceLevel   String? // optional self-described level, e.g. "Early career" | "Mid-career" | "Senior"
  contactEmail      String?
  websiteUrl        String?
  profileVisibility String    @default("PUBLIC") // PUBLIC | PRIVATE
  aiConsent         Boolean   @default(false)
  onboarded         Boolean   @default(false)
  isDemo            Boolean   @default(false) // true = fixture account from scripts/seed.ts
  role              String    @default("USER") // USER | ADMIN (reserved for moderation)
  deletedAt         DateTime?
  // ---------- Account recovery (forgot password) ----------
  // Only the SHA-256 of the normalized recovery key is stored — the plaintext
  // key is shown to the user exactly once (at setup/rotation) and never
  // persisted, logged or emailed. See src/lib/recovery.ts.
  recoveryKeyHash   String?
  recoveryKeySetAt  DateTime?
  // ---------- Google OAuth (direct OIDC — src/lib/auth/google-oauth.ts) ----------
  // Google identity (`sub` claim) for accounts linked through "Continue with
  // Google". Null for password-only accounts. Linking is explicit and never
  // overwrites a password (docs/google-auth.md).
  googleId          String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  passwordResets    PasswordResetToken[]
  professions       ProfileProfession[]
  skills            ProfileSkill[]
  mediaAssets       MediaAsset[]
  laxiiConversations LaxiiConversation[]
  laxiiUsage        LaxiiUsage[]
  laxiiResumes      LaxiiResume[]
  projects          Project[]
  collections       Collection[]
  savedProjects     SavedProject[]
  followsGiven      Follow[]            @relation("follower")
  followsReceived   Follow[]            @relation("following")
  inquiriesSent     Inquiry[]           @relation("inquirySender")
  inquiriesReceived Inquiry[]           @relation("inquiryRecipient")
  notifications     Notification[]
  profileViews      ProfileView[]
  blocksMade        Block[]             @relation("blocker")
  blocksReceived    Block[]             @relation("blocked")
  reportsMade       Report[]
  aiConversations   AiConversation[]
  aiUsage           AiUsage[]
  agentTasks        AgentTask[]
  agentArtifacts    AgentArtifact[]
  exportJobs        ExportJob[]
  deletionRequests  DeletionRequest[]
  auditEvents       AuditEvent[]
  siteMaterials     SiteMaterial[]
  siteRevisions     SiteRevision[]
  siteDesign        SiteDesign?
  giftzRepositories GiftzRepository[]
  giftzSites        GiftzSite[]        @relation("giftzSites")
  siteStudioSessions SiteStudioSession[] @relation("siteStudioSessions")
  riisheAutomations  RiisheAutomation[]  @relation("riisheAutomations")
  riisheContactNotes RiisheContactNote[] @relation("riisheContactNotes")
  riisheWorkflows    RiisheWorkflow[]    @relation("riisheWorkflows")
  riisheWorkflowSteps RiisheWorkflowStep[] @relation("riisheWorkflowSteps")
  riisheShortlist    RiisheCreatorShortlist[] @relation("riisheShortlist")
  riishePreferences  RiisheUserPreference[]   @relation("riishePreferences")
  // ---------- Creator social feed (Discover) ----------
  posts         Post[]
  postLikes     PostLike[]
  postBookmarks PostBookmark[]
  postComments  PostComment[]
  // ---------- Social network expansion (additive) ----------
  accountEdgesSet      AccountEdge[] @relation("accountEdgeOwner") // mute/restrict this user set on others
  accountEdgesReceived AccountEdge[] @relation("accountEdgeTarget") // mute/restrict others set on this user
  postCommentLikes     PostCommentLike[]
  hiddenPosts          PostHidden[] // negative feed feedback ("not interested")
  conversationMemberships ConversationParticipant[]
  directMessages       Message[]
  searchHistory        SearchQuery[]
  notificationSettings NotificationSetting[]
  // ---------- Portfolio studio + AI design chat (M22 restoration, additive) ----------
  // Restored 2026-11-14 after the models were lost in the 2026-11-11 lineage
  // reconstruction (see docs/ops/MILESTONE_EXECUTION_PROTOCOL.md §7 CB-2).
  // Field definitions were reconstructed from the surviving route/lib/view
  // code that references them — every field is evidenced by an actual query
  // or consumed response shape.
  portfolio           Portfolio?
  designChatMessages  DesignChatMessage[]
  // ---------- Opportunity Exchange (O1, additive) ----------
  employerOrganizationsCreated EmployerOrganization[] @relation("employerOrgCreator")
  employerMemberships          EmployerMembership[]   @relation("employerMemberships")
  employerVerificationReviews  EmployerVerification[] @relation("employerVerifications")
  // ---------- Opportunity Exchange (O2, additive) ----------
  candidateOpportunityProfile CandidateOpportunityProfile?  @relation("candidateOpportunityProfile")
  candidateVisibilityConsents CandidateVisibilityConsent[]  @relation("candidateVisibilityConsents")
  // ---------- Opportunity Exchange (O3, additive) ----------
  employerOpportunitiesCreated   Opportunity[] @relation("employerOpportunitiesCreated")
  employerOpportunitiesPublished Opportunity[] @relation("employerOpportunitiesPublished")
  shortlistsAddedBy CandidateShortlist[] @relation("shortlistsAddedBy")
  // ---------- Opportunity Exchange (M-O4, additive) ----------
  talentMatches TalentMatch[] @relation("talentMatches")
  // ---------- Opportunity Exchange (M-O5, additive) ----------
  shortlistedCandidates CandidateShortlist[] @relation("shortlistedCandidates")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // retention sweep: purge expired sessions
}

model Profession {
  id       String @id @default(cuid())
  slug     String @unique
  label    String
  group    String // LEGACY flat-group label (e.g. "Film & Motion", "Design") — kept for backward compatibility
  order    Int    @default(0)

  // Universal taxonomy (additive): hierarchical family + descriptive metadata.
  // Loose slug reference (no FK) matches the codebase's curated-taxonomy style;
  // seeds insert families before professions.
  familySlug  String? // ProfessionFamily.slug — null for legacy rows until reseeded
  description String? // one-line scope note (planner grounding / directory)
  aliases     String? // JSON string[] of alternate labels (search/matching only)
  active      Boolean @default(true) // retired slugs stay queryable but hidden from pickers

  profiles ProfileProfession[]

  @@index([familySlug])
}

// ---------- Universal profession taxonomy (additive) ----------
// Hierarchical, expandable profession system: family → profession → specialism.
// Expansion is data-driven (seeds), never code changes. The legacy flat
// Profession.group label is retained so the existing UI keeps receiving a
// backward-compatible flat {slug,label,group} list.
model ProfessionFamily {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// A specialism narrows a profession (e.g. "Broadcast Journalist" under
// "Journalism"). Loose professionSlug reference, indexed for directory reads.
model Specialism {
  id             String   @id @default(cuid())
  slug           String   @unique
  professionSlug String // Profession.slug (loose reference)
  label          String
  order          Int      @default(0)

  @@index([professionSlug])
}

model ProfileProfession {
  userId       String
  professionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@id([userId, professionId])
}

model Skill {
  id       String @id @default(cuid())
  slug     String @unique
  label    String

  profiles         ProfileSkill[]
  projects         ProjectSkill[]
  opportunitySkills OpportunitySkill[]
}

model ProfileSkill {
  userId  String
  skillId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

// ---------- Media ----------

model MediaAsset {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        String // IMAGE | VIDEO | AUDIO | DOCUMENT
  filename    String
  mime        String
  size        Int
  width       Int?
  height      Int?
  status      String   @default("READY") // PENDING (presigned, awaiting direct upload) | READY | FAILED
  storagePath String // path under /uploads
  createdAt   DateTime @default(now())

  projectMedia ProjectMedia[]
  projectCovers Project[]
  postMedia        PostMedia[]
  postMediaPosters PostMedia[] @relation("PostMediaPoster")
  siteMaterials SiteMaterial[]
  laxiiVersions LaxiiImageVersion[]
  agentArtifacts AgentArtifact[]

  @@index([ownerId])
  // PENDING-upload sweep (queue/handlers.ts): status + createdAt window scan.
  @@index([status, createdAt])
}

// ---------- Projects ----------

model Project {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  summary      String?
  description  String?
  category     String? // profession slug
  status       String    @default("DRAFT") // DRAFT | PUBLISHED
  visibility   String    @default("PUBLIC") // PUBLIC | UNLISTED | PRIVATE
  coverMediaId String?
  brief        String?
  process      String?
  challenges   String?
  outcome      String?
  role         String? // creator's contribution
  tools         String? // JSON string array of tool names (SQLite has no array type)
  // Universal Studio (additive, optional): JSON envelope with the project's
  // profession-aware metadata — { kind, templateId, fields, custom }. Nullable
  // so every pre-existing project stays valid untouched; parsed defensively at
  // the serializer boundary (lib/serialize.ts).
  customFields  String?
  externalUrl  String?
  repoUrl      String?
  publishedAt  DateTime?
  // Universal Studio portfolio curation (additive, optional): when set, the
  // creator has featured this project — it orders first on their public
  // profile and website project sections. Nullable so every pre-existing
  // project stays valid untouched; only PUBLISHED projects may be featured.
  featuredAt   DateTime?
  // Universal Studio project management (additive, optional): when set, the
  // project lives in the owner's private Archive — hidden from the active
  // Drafts/Published lists but never deleted, and restorable at any time.
  // Nullable so every pre-existing project stays valid untouched. Archived
  // projects are always excluded from every public surface (they are owner-
  // private regardless of status).
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  coverMedia   MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  skills       ProjectSkill[]
  media        ProjectMedia[]
  contributors Contributor[]
  savedBy      SavedProject[]
  collections  CollectionItem[]
  views        ProjectView[]
  inquiries    Inquiry[]

  @@index([ownerId])
  @@index([status, visibility, publishedAt])
  @@index([category]) // category-filtered discovery/search queries
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId]) // skill-side joins in search/discovery
}

model ProjectMedia {
  projectId String
  mediaId   String
  order     Int     @default(0)
  caption   String?

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaId])
  @@index([mediaId]) // media delete ref-count lookups
}

model Contributor {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String?
  name         String
  role         String?
  contribution String?

  @@index([projectId])
}

// ---------- Discovery ----------

model SavedProject {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId]) // project-side saved counts / moderation lookups
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]
}

model CollectionItem {
  collectionId String
  projectId    String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([collectionId, projectId])
  @@index([projectId]) // profile page item filters
}

model Follow {
  followerId  String
  followingId String
  status      String   @default("ACTIVE") // ACTIVE | PENDING (private-account follow request awaiting approval)
  createdAt   DateTime @default(now())
  respondedAt DateTime? // when a PENDING request was approved (stays null for instant follows)

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followingId, status]) // ACTIVE-only follower counts + follower lists
  @@index([followerId, status]) // ACTIVE-only following lists
}

// ---------- Connections ----------

model Inquiry {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  projectId   String?
  type        String    @default("INQUIRY") // INQUIRY | COLLABORATION | INVITE
  subject     String
  message     String
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  sender    User     @relation("inquirySender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("inquiryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([senderId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // FOLLOW | FOLLOW_REQUEST | FOLLOW_ACCEPTED | POST_LIKE | POST_COMMENT | COMMENT_REPLY | MENTION | POST_SHARE | MESSAGE | MESSAGE_REQUEST | INQUIRY | INQUIRY_RESPONSE | SAVE | SYSTEM
  payload   String    @default("{}") // JSON string
  actorId   String? // who triggered the notification (self-actions never notify) — used for grouping + suppression
  targetId  String? // post/comment/conversation id the notification is about — used for grouping
  dedupKey  String? // retry-safety: retries with the same key upsert instead of duplicating (null = never deduped)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([dedupKey]) // NULL dedupKeys are never deduped (SQLite allows multiple NULLs)
  @@index([userId])
  @@index([userId, readAt]) // unread-count queries
  @@index([userId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId]) // visibility-filter OR-scan on public routes
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // PROJECT | PROFILE | MESSAGE
  targetId   String
  reason     String
  details    String?
  status     String   @default("OPEN") // OPEN | REVIEWED | RESOLVED
  createdAt  DateTime @default(now())

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// ---------- Insights ----------
// Dedup rule: one view per viewerKey per UTC day per target. Counts are ESTIMATED.

model ProjectView {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewerUserId String? // plain scalar (no FK) so anonymous tracking stays lightweight
  viewerKey    String // "u:<userId>" for signed-in, "a:<anonCookie>" otherwise
  day          String // UTC "YYYY-MM-DD"
  createdAt    DateTime @default(now())

  @@unique([projectId, viewerKey, day])
  @@index([projectId])
}

model ProfileView {
  id            String   @id @default(cuid())
  profileUserId String
  profile       User     @relation(fields: [profileUserId], references: [id], onDelete: Cascade)
  viewerKey     String
  day           String
  createdAt     DateTime @default(now())

  @@unique([profileUserId, viewerKey, day])
  @@index([profileUserId])
}

// ---------- Creator social feed (Discover) ----------
// Posts are the creator social layer on the Discover homepage: text updates,
// image carousels and video/reel posts built on the EXISTING MediaAsset
// upload+streaming infrastructure (no new storage system). Public reach is
// always derived from the author's live visibility ladder (lib/visibility.ts)
// enforced server-side on every read path — a post by an author whose profile
// is PRIVATE, demo or soft-deleted never leaves their own workspace.

model Post {
  id           String    @id @default(cuid())
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaKind    String    @default("TEXT") // TEXT | IMAGE | VIDEO — derived at creation from the attached media, kept denormalized for feed queries
  body         String    @default("") // caption / text body
  hashtags     String    @default("[]") // JSON string[] of normalized tags (lowercase, no '#') — creator-selected, no auto-keywords (mirror of PostHashtag rows)
  kind         String    @default("UPDATE") // UPDATE | ANNOUNCEMENT | WIP | TUTORIAL | QUESTION — creator-selected professional post type
  location     String?   // optional creator-written location tag (plain text, never GPS)
  profession   String?   // creator-selected category = Profession.slug (loose reference, matches the curated-taxonomy style)
  status       String    @default("PUBLISHED") // PUBLISHED | DRAFT (author-only) | SCHEDULED (auto-publishes at scheduledAt)
  visibility   String    @default("PUBLIC") // PUBLIC | PRIVATE (PRIVATE = author-only, never indexed)
  scheduledAt  DateTime? // for SCHEDULED posts: publish moment (sweeps on read + queue worker)
  shares       Int       @default(0) // share-click counter (like real social share counts)
  impressions  Int       @default(0) // lifetime feed impressions (served-in-feed counter; distinct from PostView = actual views)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  media       PostMedia[]
  likes       PostLike[]
  comments    PostComment[]
  bookmarks   PostBookmark[]
  views       PostView[]
  postHashtags PostHashtag[]
  shareEvents  PostShareEvent[]
  impressionDays PostImpressionDay[]
  hiddenBy     PostHidden[]

  @@index([authorId, createdAt])
  @@index([status, visibility, createdAt])
  @@index([mediaKind, status, visibility, createdAt])
}

model PostMedia {
  id                 String @id @default(cuid())
  postId             String
  post               Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId       String
  mediaAsset         MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  order              Int        @default(0)
  altText            String     @default("") // creator-written media alt text (accessibility + SEO)
  posterMediaAssetId String? // optional IMAGE asset used as the video thumbnail
  posterMediaAsset   MediaAsset? @relation("PostMediaPoster", fields: [posterMediaAssetId], references: [id], onDelete: SetNull)

  @@unique([postId, mediaAssetId])
  @@index([postId])
}

model PostLike {
  postId    String
  userId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId]) // duplicate likes are structurally impossible
  @@index([userId])
}

model PostBookmark {
  postId    String
  userId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId]) // duplicate bookmarks are structurally impossible
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String? // replies (one level — the UI threads replies under their parent)
  parent    PostComment?  @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("commentThread")
  body      String
  status    String   @default("VISIBLE") // VISIBLE | HIDDEN — a RESTRICTED author's comments start HIDDEN; visible to their author + the post owner, who can approve (→ VISIBLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commentLikes PostCommentLike[]

  @@index([postId, status, createdAt]) // public listing filters status
  @@index([authorId])
}

model PostView {
  postId    String
  viewerKey String // "u:<userId>" for signed-in, "a:<anonCookie>" otherwise — same scheme as ProjectView
  day       String // UTC "YYYY-MM-DD"
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, viewerKey, day]) // deduped per viewer per day
  @@index([postId])
}

// ---------- Social network expansion (additive — real social graph) ----------

/// Per-pair relationship controls the OWNER sets on the TARGET: mute (their
/// activity never reaches my feeds or notifications) and restrict (their new
/// comments on MY posts start HIDDEN until I approve). Block remains its own
/// dedicated model — it is a stronger, bidirectional exclusion.
model AccountEdge {
  id        String   @id @default(cuid())
  userId    String // who set the controls
  targetId  String // who they are controlled for
  muted      Boolean @default(false)
  restricted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User @relation("accountEdgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("accountEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@index([targetId]) // "who muted/restricted me" reverse checks
}

model PostCommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId]) // duplicate likes are structurally impossible
  @@index([userId])
}

/// Negative relevance feedback: "not interested" — excluded from For You and
/// Trending for that user forever. Private to the viewer; never affects others.
model PostHidden {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

/// Real share-event ledger behind the Post.shares counter (analytics need
/// time-scoped share totals; a bare counter cannot provide them).
model PostShareEvent {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String? // null for anonymous shares
  channel   String   @default("link") // link | copy | native
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

/// Daily impression buckets — time-scoped analytics without scanning events.
/// Sum over days = impressions in range; Post.impressions stays the lifetime cache.
model PostImpressionDay {
  postId String
  day    String // UTC "YYYY-MM-DD"
  count  Int    @default(0)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, day])
  @@index([postId])
}

/// Hashtag dictionary (normalized names) — powers discovery, trending and
/// autocomplete. Post.hashtags stays the denormalized mirror for cheap reads.
model Hashtag {
  id         String   @id @default(cuid())
  name       String   @unique // lowercase, no '#', [a-z0-9_]
  postCount  Int      @default(0) // ACTIVE public-post usage count (maintained on post create/edit/delete)
  lastUsedAt DateTime @default(now())

  posts PostHashtag[]

  @@index([postCount]) // trending queries
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

/// Per-user, per-type notification preferences (absent row = enabled).
model NotificationSetting {
  userId  String
  type    String
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

/// One-to-one conversations. Message REQUESTS: when the recipient does not
/// follow the sender (ACTIVE), the recipient's participant row starts PENDING
/// — they must accept before the sender can continue the thread.
model Conversation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt]) // inbox ordering
}

model ConversationParticipant {
  conversationId String
  userId         String
  requestState   String    @default("ACTIVE") // ACTIVE | PENDING | DECLINED (recipient side of a message request)
  lastReadAt     DateTime? // read receipts (own reads are always visible to self)
  archivedAt     DateTime? // inbox archive (per-participant, private)
  typingUntil    DateTime? // short-lived typing indicator (polled, ≤6s horizon)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt]) // inbox listing
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @default("")
  mediaAssetId   String? // loose ref to MediaAsset — ownership + READY validated at send; streamed via existing /api/media/[id]/raw
  sharedPostId   String? // loose ref to Post — viewability re-validated for every recipient at read time
  createdAt      DateTime  @default(now())
  deletedAt      DateTime? // sender-initiated unsend (soft delete keeps thread structure)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt]) // thread paging
}

/// Search history (signed-in users only, per-scope). Private to the owner;
/// clearable at any time (privacy control).
model SearchQuery {
  id        String   @id @default(cuid())
  userId    String
  query     String
  scope     String   @default("all") // people | posts | hashtags | all
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- AI ----------

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT | SYSTEM
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String // improve | suggest | chat
  // Documented per-call cost estimate in integer cents (0 = no metered cost).
  // An ESTIMATE from the provider registry — never a billed amount.
  costEstimateCents Int @default(0)
  createdAt DateTime @default(now())

  @@index([userId, feature])
}

// ---------- LAXII — conversational AI image studio ----------
// One conversation = one multi-turn creation thread (image or banner kind).
// Messages record every prompt/operation; assistant messages carry the
// generated output versions (variants) as LaxiiImageVersion rows pointing at
// ordinary MediaAssets. The version tree (parentVersionId) is the source of
// truth for undo/redo, regeneration and before/after comparison.

model LaxiiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New creation")
  kind      String   @default("IMAGE") // IMAGE | BANNER | RESUME | AVATAR
  bannerKind String? // banner category slug when kind = BANNER (e.g. "youtube-channel")
  // Banner canvas geometry (null for IMAGE conversations)
  canvasWidth  Int?
  canvasHeight Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages LaxiiMessage[]
  versions LaxiiImageVersion[]
  resume   LaxiiResume?

  @@index([userId, updatedAt])
}

model LaxiiMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   LaxiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // USER | ASSISTANT | SYSTEM
  text           String @default("") // the user's prompt (USER) or a system note
  operation      String? // GENERATE | EDIT | VARIATIONS | UPSCALE | REMOVE_BACKGROUND | EXPAND | BANNER | RESTORE | RESUME_GENERATE | RESUME_TAILOR | RESUME_REPHRASE | RESUME_UPDATE
  provider       String? // managed | gemini | openai
  model          String? // exact provider model id used
  status         String  @default("DONE") // DONE | FAILED
  error          String? // user-safe failure message when status = FAILED
  metaJson       String? // JSON: { aspect, requestedSize, refs: [...], usage, warnings }
  createdAt      DateTime @default(now())

  versions LaxiiImageVersion[]

  @@index([conversationId, createdAt])
}

model LaxiiImageVersion {
  id              String        @id @default(cuid())
  messageId       String
  message         LaxiiMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    LaxiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaId         String
  media           MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  parentVersionId String?
  parent          LaxiiImageVersion?  @relation("laxiiVersionTree", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        LaxiiImageVersion[] @relation("laxiiVersionTree")
  isSelected      Boolean       @default(false)
  isFavourite     Boolean       @default(false)
  width           Int?
  height          Int?
  prompt          String?
  operation       String?
  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([parentVersionId])
  @@index([mediaId])
}

model LaxiiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String // laxii.generate | laxii.edit | laxii.variations | laxii.upscale | laxii.removeBackground | laxii.expand | laxii.banner
  provider  String
  model     String
  operation String
  // Documented per-image cost estimate in integer cents (0 = no metered cost).
  // An ESTIMATE from the provider registry — never a billed amount.
  costEstimateCents Int @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature])
}

// ---------- Cross-agent orchestration (BEAN Intelligence) ----------
// Durable task record for work delegated between agents (RIISHE → LAXII,
// RIISHE → CODE GIFTZ, CODE GIFTZ → LAXII). One hop per delegation, always
// user-visible; no autonomous agent-to-agent loops. stepsJson is a JSON array
// of step records; resultJson carries the agent's structured outcome.
// Phase 4: kind "ENGINEERING_TASK" (agent CODE_GIFTZ) uses an extended status
// vocabulary on this same string column — QUEUED | ANALYZING | PLANNING |
// AWAITING_APPROVAL | EXECUTING | VALIDATING | TESTING | COMPLETED | FAILED |
// CANCELLED — plus repoId → GiftzRepository. All other consumers are unaffected.
model AgentTask {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        String // RIISHE | LAXII | CODE_GIFTZ — the agent that owns/performS the task
  kind         String // e.g. BANNER_DESIGN | AVATAR_DESIGN | WEBSITE_DESIGN | RESEARCH
  title        String
  // PENDING | RUNNING | AWAITING_APPROVAL | COMPLETED | FAILED | CANCELLED
  status       String     @default("PENDING")
  parentTaskId String?
  parentTask   AgentTask? @relation("agentTaskTree", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   AgentTask[] @relation("agentTaskTree")
  stepsJson    String     @default("[]")
  resultJson   String?
  error        String?
  // Phase 4 (ENGINEERING_TASK): authorized workspace repository this task runs on.
  repoId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Phase 5: artifacts produced by this task (source) and consumed by it (destination).
  producedArtifacts  AgentArtifact[] @relation("artifactSource")
  consumedArtifacts  AgentArtifact[] @relation("artifactDestination")

  @@index([userId, updatedAt])
  @@index([status])
}

// ---------- Phase 5 — cross-capability artifact references ----------
// A safe shared reference to an EXISTING MediaAsset produced by one agent task
// and consumed by another (CODE GIFTZ ⇄ LAXII). Files are never copied or
// moved: the row carries metadata + the mediaId only; bytes are read through
// the storage layer behind ownership checks. Private storage paths and
// credentials never cross a service boundary — clients see mediaId and the
// ownership-checked /api/media/[id]/raw URL, nothing else. Status lifecycle:
// ACTIVE (fresh, verified) → CONSUMED (integrated exactly once) | EXPIRED
// (TTL passed) | MISSING (media row or blob gone) — resolved honestly, never
// silently.
model AgentArtifact {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId           String
  media             MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sourceTaskId      String?
  sourceTask        AgentTask? @relation("artifactSource", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  destinationTaskId String?
  destinationTask   AgentTask? @relation("artifactDestination", fields: [destinationTaskId], references: [id], onDelete: SetNull)
  role              String     @default("ASSET") // ASSET | BANNER | HERO | ...
  mime              String
  width             Int?
  height            Int?
  sizeBytes         Int
  // ACTIVE | CONSUMED | EXPIRED | MISSING
  status            String     @default("ACTIVE")
  expiresAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId, createdAt])
  @@index([destinationTaskId])
  @@index([mediaId])
}

// ---------- CODE GIFTZ Engineering workspaces (Phase 4) ----------
// Durable registry of user-authorized repositories the engineering agent may
// inspect and (after explicit approval) modify. Files live on disk under
// data/giftz-workspaces/<id>; the path is ALWAYS derived from the row id and
// never stored from user input. Deleting the row archives/removes the
// workspace directory; completed tasks keep their repoId for history.
model GiftzRepository {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  // READY | ARCHIVED
  status    String   @default("READY")
  sizeBytes Int      @default(0)
  fileCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

// ---------- LAXII Resume Studio ----------
// One editable resume document per resume conversation. dataJson holds the
// full resume JSON (JSON-Resume-schema-informed structure); factsJson keeps
// a snapshot of EXACTLY what the user provided, so AI wording suggestions can
// always be told apart from user facts. Exports (PDF/DOCX) are rendered
// on demand and never overwrite this editable source.
model LaxiiResume {
  id             String            @id @default(cuid())
  conversationId String            @unique
  conversation   LaxiiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeType     String            @default("ats") // ats | modern | minimal | creative | technical | fresher | experienced | role-specific
  template       String            @default("classic") // classic | modern | minimal | creative
  dataJson       String            @default("{}") // resume document JSON (see src/lib/laxii/resume-schema.ts)
  factsJson      String            @default("{}") // user-provided facts snapshot (provenance)
  aiTouchedJson  String            @default("[]") // section keys whose wording the AI touched
  targetTitle    String?
  jobDescription String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId, updatedAt])
}

// ---------- Website Builder ----------
// One custom website per profile. Drafts are private; only publishedConfig is
// rendered for visitors on the public profile (the real public URL).

model SiteDesign {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftConfig     String? // JSON SiteConfig draft — always private to the owner
  publishedConfig String? // JSON snapshot of the config at publish time
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt     DateTime?
  // Platform-level setting (NOT part of the site snapshot): renders the small
  // "Made with BEAN Folio · Code Giftz" attribution in the site footer. It is
  // applied by the renderer at view time — never stored inside publishedConfig —
  // so republishing can never duplicate it and editing content cannot corrupt it.
  watermark       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------- Website source materials (Code Giftz "create my own website") ----------
// Files the user uploaded AS INPUT for a custom website build. One row per
// uploaded MediaAsset, owned by the uploader; extractedText holds capped text
// pulled out of PDFs/text documents server-side. Materials are private to
// their owner and are only ever consumed by the user's own Code Giftz
// generation requests — they never appear in any public API.
model SiteMaterial {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  label         String // original filename (display only)
  kind          String // IMAGE | VIDEO | AUDIO | DOCUMENT (mirrors media.kind)
  // READY = usable content extracted; EMPTY = stored but nothing extractable
  // (images are catalogued, video/audio are not transcribed); FAILED = the
  // extraction itself errored.
  extractStatus String     @default("EMPTY")
  extractedText String? // capped extracted text (PDF/text documents)
  note          String? // honest capability note shown to the user
  metaJson      String? // JSON: { pages?, chars?, width?, height?, description? }
  createdAt     DateTime   @default(now())

  @@index([userId])
}

// ---------- Website draft revisions (reversible Code Giftz changes) ----------
// A snapshot of the saved draft taken automatically right before the draft is
// overwritten (manual save) or restored. Keeps the user's original version
// recoverable even after a Code Giftz proposal is accepted, saved and the
// browser session ends. Bounded per user (pruned to the newest 10).
model SiteRevision {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // why the snapshot exists ("Before save", "Before restore")
  config    String // JSON SiteConfig snapshot
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------- Website Studio chat (Code Giftz conversational website coding) ----------
// A named chat thread per user for the Visual Website Coding Studio. Messages
// record the real conversation; assistant messages carry the ISOLATED working
// copy (proposal) produced by the plan→execute pipeline — the proposal lives
// ONLY in the message row (never in draftConfig) until the user explicitly
// saves it, so previewing can never overwrite the saved or published site.
model SiteStudioSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("siteStudioSessions", fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("New session")
  // Conversation target — PRODUCT SEPARATION (owner directive): "portfolio"
  // sessions belong to Customization (the user's single portfolio site,
  // SiteDesign); "giftz" sessions belong to GIFTZ (independently generated
  // sites, GiftzSite). A giftz turn never reads or writes the portfolio
  // draft, and a portfolio turn never touches a GiftzSite.
  targetKind  String   @default("portfolio") // portfolio | giftz
  targetSiteId String? // GiftzSite id when targetKind = "giftz"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages SiteStudioMessage[]

  @@index([userId, updatedAt])
}

model SiteStudioMessage {
  id        String            @id @default(cuid())
  sessionId String
  session   SiteStudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // USER | ASSISTANT | SYSTEM
  text      String            @default("")
  // Execution state for assistant turns: PENDING | RUNNING | DONE | FAILED
  status    String            @default("DONE")
  // ASSISTANT turns only — the isolated working copy + change inventory:
  // { config: SiteConfig, changedFiles: [...], summary, verification, taskId }
  proposalJson String? // null = plain reply (no changes proposed)
  error     String? // user-safe failure message when status = FAILED
  taskId    String? // AgentTask id driving this turn (progress polling)
  metaJson  String? // { mode, baseConfigHash, stage }
  createdAt DateTime          @default(now())

  @@index([sessionId, createdAt])
  @@index([taskId])
}

// ---------- GIFTZ generated sites (independent prompt-driven websites) ----------
// GIFTZ builds COMPLETE websites from natural-language prompts. Each generated
// site is its OWN artifact — fully separate from the user's portfolio website
// (SiteDesign) and from Customization state: generating, refining, saving or
// publishing a GiftzSite never touches the portfolio draft/published snapshot,
// and Customization never touches a GiftzSite. config is the working draft;
// publishedConfig is the immutable snapshot visitors see once PUBLISHED.
model GiftzSite {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("giftzSites", fields: [userId], references: [id], onDelete: Cascade)
  title           String   @default("Untitled site")
  // The originating prompt (bounded) — provenance for the creator only.
  sourcePrompt    String?
  // Short project description (bounded, creator-facing metadata only).
  description     String?
  // Project framework of the generated file tree. "standard-static" is the
  // compiled static site (HTML/CSS/JS + package.json + site.config.json).
  framework       String   @default("standard-static")
  config          String? // JSON SiteConfig working draft — private to the owner
  publishedConfig String? // JSON snapshot published for visitors (PUBLISHED only)
  status          String   @default("DRAFT") // DRAFT | PUBLISHED
  // Standalone-platform publish pipeline state:
  // DRAFT | BUILDING | PREVIEW | READY_TO_PUBLISH | DEPLOYING | PUBLISHED | FAILED
  deployStatus    String   @default("DRAFT")
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revisions      GiftzSiteRevision[]
  projectFiles   GiftzProjectFile[]  @relation("giftzProjectFiles")
  versions       GiftzProjectVersion[] @relation("giftzProjectVersions")
  builds         GiftzBuild[]        @relation("giftzBuilds")
  deployments    GiftzDeployment[]   @relation("giftzDeployments")
  domains        GiftzDomain[]       @relation("giftzDomains")
  activities     GiftzActivity[]     @relation("giftzActivities")

  @@index([userId, updatedAt])
}

// ---------- GIFTZ standalone platform: real project files ----------
// Every GIFTZ website project owns a REAL editable file tree. Files are DB
// rows (bounded content) — `source` tracks who last wrote the file so the
// deterministic compiler can regenerate its own output without clobbering
// creator or AI edits:
//   generated — produced by compileGiftzProjectFiles() from the SiteConfig
//               content model; safely regenerated on every config save.
//   user      — written through the code editor; the compiler never
//               overwrites these (regeneration skips them and reports it).
//   ai        — written by the GIFTZ file-level agent; same protection.
// `site.config.json` is the two-way bridge: the visual editor's content model
// lives inside the file tree so code edits to it sync back into GiftzSite.config.
model GiftzProjectFile {
  id        String    @id @default(cuid())
  siteId    String
  site      GiftzSite @relation("giftzProjectFiles", fields: [siteId], references: [id], onDelete: Cascade)
  path      String // confined relative path — no absolute, no "..", no backslash
  content   String // text content (binary assets are base64-encoded data handled by the compiler with size caps)
  encoding  String    @default("utf8") // utf8 | base64
  source    String    @default("generated") // generated | user | ai
  sizeBytes Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([siteId, path])
  @@index([siteId, updatedAt])
}

// ---------- GIFTZ standalone platform: project version snapshots ----------
// Full-file-tree snapshots taken on saves, AI proposal applies, publishes and
// restores (bounded per site). `source` records who created the version.
// Versions with source "publish" are protected from pruning — the last
// published state is always recoverable.
model GiftzProjectVersion {
  id        String    @id @default(cuid())
  siteId    String
  site      GiftzSite @relation("giftzProjectVersions", fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  // ai | user | publish | restore | auto
  source    String    @default("auto")
  filesJson String // JSON: { files: [{ path, content, encoding, source }], config: SiteConfig | null }
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([siteId, createdAt])
}

// ---------- GIFTZ standalone platform: build jobs ----------
// Deterministic production/validation builds of the project file tree.
// Diagnostics are honest per-file findings; the artifact is the built file
// set (deployments serve from it). No fabricated success.
model GiftzBuild {
  id              String    @id @default(cuid())
  siteId          String
  site            GiftzSite @relation("giftzBuilds", fields: [siteId], references: [id], onDelete: Cascade)
  // QUEUED | BUILDING | SUCCEEDED | FAILED
  status          String    @default("QUEUED")
  // manual | publish | ai
  trigger         String    @default("manual")
  diagnosticsJson String? // JSON: { checks: [{ path, severity, message }], summary, checksRun, durationMs }
  artifactJson    String? // SUCCEEDED only: { files: [{ path, mime, encoding, content }] }
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  deployments GiftzDeployment[]

  @@index([siteId, createdAt])
}

// ---------- GIFTZ standalone platform: deployment records ----------
// Real publishing lifecycle records. provider "bean-folio-hosting" serves the
// built artifact at the site's public path; external providers go through
// deployment adapters and are honestly reported as not-configured when absent.
model GiftzDeployment {
  id         String     @id @default(cuid())
  siteId     String
  site       GiftzSite  @relation("giftzDeployments", fields: [siteId], references: [id], onDelete: Cascade)
  buildId    String?
  build      GiftzBuild? @relation(fields: [buildId], references: [id], onDelete: SetNull)
  // PREPARING | DEPLOYING | LIVE | FAILED | ROLLED_BACK
  status     String     @default("PREPARING")
  provider   String     @default("bean-folio-hosting")
  url        String? // public URL of this deployment (set only when LIVE)
  filesJson  String? // served artifact: { files: [{ path, mime, encoding, content }] }
  error      String?
  deployedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([siteId, createdAt])
}

// ---------- GIFTZ standalone platform: custom domains ----------
// Configuration + verification records for custom domains. Verification is a
// real DNS resolution check (never fabricated); routing requires an external
// hosting/DNS configuration that is honestly reported when absent.
model GiftzDomain {
  id                String    @id @default(cuid())
  siteId            String
  site              GiftzSite @relation("giftzDomains", fields: [siteId], references: [id], onDelete: Cascade)
  hostname          String // lowercase, no scheme, no path
  // PENDING | VERIFIED | FAILED
  status            String    @default("PENDING")
  verificationToken String    @default("")
  verifiedAt        DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([hostname])
  @@index([siteId])
}

// ---------- GIFTZ standalone platform: project activity ----------
// Append-only activity feed for AI agent operations and creator actions on a
// project (audit trail per project; AuditEvent remains the platform-wide log).
model GiftzActivity {
  id         String    @id @default(cuid())
  siteId     String
  site       GiftzSite @relation("giftzActivities", fields: [siteId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // site.create | ai.compose | ai.edit | file.write | file.delete | build | deploy | publish | version.save | version.restore | domain.add | domain.verify
  detailJson String    @default("{}")
  createdAt  DateTime  @default(now())

  @@index([siteId, createdAt])
}

// Snapshots of a GiftzSite taken before each save — revisions preserve the
// creator's earlier generated versions (bounded per site, pruned to newest 10).
model GiftzSiteRevision {
  id        String    @id @default(cuid())
  siteId    String
  site      GiftzSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  config    String // JSON SiteConfig snapshot
  createdAt DateTime  @default(now())

  @@index([siteId, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String // e.g. "privacy.update", "account.deletion_request", "auth.login"
  targetType  String?
  targetId    String?
  meta        String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
}

model ExportJob {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | READY | FAILED
  payload     String? // full JSON export of the user's own data
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
}

model DeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason      String?
  status      String    @default("PENDING") // PENDING | COMPLETED
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// ---------- Account recovery ----------
// Single-use, short-lived password-reset authorization issued only after BOTH
// the account email AND the account's recovery key verified server-side.
// Only the SHA-256 of the token is stored; the plaintext token lives exactly
// long as the client's reset attempt.

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256 hex of the opaque token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt]) // retention sweep
}

// ---------- Durable background jobs (Phase 2: horizontal scale) ----------
// DB-backed queue so expensive work (AI generation, media processing,
// maintenance sweeps) survives restarts, can run on any instance, and reports
// honest status. Workers claim rows atomically via a status-guarded update;
// retries use exponential backoff; DEAD = exceeded maxAttempts (dead-letter).
// Lifecycle: QUEUED → RUNNING → SUCCEEDED | FAILED (retry, backoff) → DEAD.
// CANCELLED is user/ops requested. dedupeKey (nullable unique) gives
// idempotent enqueue: one active job per key (NULL keys never conflict).
model BackgroundJob {
  id          String    @id @default(cuid())
  kind        String // e.g. "site.studio-turn", "media.thumbnails", "maintenance.sweep"
  status      String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | FAILED | DEAD | CANCELLED
  userId      String? // owner-scoped quota + per-user concurrency (null = system job)
  payload     String    @default("{}") // JSON
  runAt       DateTime  @default(now()) // earliest execution time (backoff)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  claimedBy   String? // worker instance id
  claimedAt   DateTime?
  heartbeatAt DateTime? // liveness for stuck-RUNNING recovery
  dedupeKey   String?   @unique // optional idempotency: one active job per key
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([kind, status])
  @@index([userId, createdAt])
}

// ---------- Shared rate-limit buckets (opt-in) ----------
// Fixed-window counters for RATE_LIMIT_BACKEND=postgres deployments. The
// default backend stays in-memory (single instance); this table lets small
// multi-instance deployments share abuse-sensitive buckets (login, AI, upload)
// through one atomic upsert per request without provisioning Redis. Rows are
// pruned by the maintenance sweep. One row per (key, window).
model RateLimitBucket {
  key         String // e.g. "login:ip:<hash>" — always hashed/opaque
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime // windowStart + window; pruned by maintenance

  @@id([key, windowStart])
  @@index([expiresAt])
}

// ---------- Shared cache (opt-in) ----------
// CACHE_BACKEND=postgres deployments share viewer-independent PUBLIC cache
// entries (published profiles, profession taxonomy) through this table so
// every instance reads the same data and sees the same invalidation. The
// cache API enforces a public-key whitelist — private/per-viewer data is
// refused at the write boundary and can never enter a shared store.
// SQLite has no arrays: tags is a JSON string array.
model CacheEntry {
  key        String   @id
  value      String // JSON payload (viewer-independent public shapes only)
  namespace  String // first key segment ("profile", "professions") — generation scope
  tags       String   @default("[]") // JSON string array of platform event tags
  expiresAt  DateTime // TTL; pruned by the maintenance sweep
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([namespace])
  @@index([expiresAt])
}

// Generation counter per namespace. Any invalidation bumps the namespace's
// generation; each process polls these rows (single tiny SELECT, default 1s)
// and drops its local L1 buffer for any namespace whose generation advanced —
// so a publish/unpublish on instance A invalidates instance B's local buffer
// within the poll interval, without a message broker.
model CacheGeneration {
  namespace  String   @id
  generation Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// ---------- Google OAuth (direct OIDC — src/lib/auth/google-oauth.ts) ----------
// Server-side authorization-flow records. The browser never carries state,
// nonce or the PKCE verifier — they live here, keyed by hashes, single-use and
// short-lived. DB-backed (not a signed cookie) so validation holds across
// horizontally scaled instances without a shared signing secret.
model OAuthFlow {
  id           String   @id @default(cuid())
  // sha256(state) — the raw state value only ever exists in the redirect URL.
  stateHash    String   @unique
  // PKCE verifier — server-side only; Google receives only the S256 challenge.
  codeVerifier String
  // sha256(nonce) — compared against the verified ID token's nonce claim.
  nonceHash    String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// A pending "link Google to your existing password account" grant. Issued ONLY
// after the Google identity was fully verified server-side (signature, issuer,
// audience, expiry, nonce, email_verified) and the verified email matches an
// existing password account. Consumed by the NEXT successful password login
// with the matching opaque cookie — the user proves account ownership once
// with their password; the password itself is never changed by linking.
model GoogleLink {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(opaque cookie token)
  googleId  String
  email     String // verified Google email this grant is scoped to
  name      String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------- RIISHE creator automation (additive) ----------
// Durable, owner-scoped automation rules the RIISHE assistant prepares at the
// user's request through the existing chat. Automations NEVER duplicate the
// platform's own records: enquiries always flow through the existing Inquiry
// model/API, reminders track an EXISTING Inquiry, and notifications reuse the
// existing Notification model (SYSTEM type). Every row is strictly scoped to
// its owner — every read/write verifies userId.
model RiisheAutomation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("riisheAutomations", fields: [userId], references: [id], onDelete: Cascade)
  // FOLLOW_UP_REMINDER | WEEKLY_SUMMARY | OPPORTUNITY_RADAR
  kind        String
  // ACTIVE | PAUSED | COMPLETED | CANCELLED
  status      String   @default("ACTIVE")
  // For FOLLOW_UP_REMINDER: the existing Inquiry this reminder tracks.
  targetId    String?
  // JSON { runAt?: ISO string, repeatDays?: number } — next run + cadence.
  scheduleJson String  @default("{}")
  // JSON { autoSend: boolean, recipientCapDays?: number } — autoSend is ALWAYS
  // false unless the account owner explicitly opts in.
  configJson  String   @default("{}")
  // JSON runtime state written by runs: { lastRunAt, lastRunSummary, autoCancelledAt? }
  stateJson   String   @default("{}")
  // Explicit opt-in for automatic sending of prepared follow-up drafts.
  // Default false: the engine only PREPARES drafts; nothing is ever sent
  // externally without the owner's explicit approval.
  autoSend    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs RiisheAutomationRun[]

  @@index([userId, status])
  @@index([status, kind])
}

// Execution history for automations (one row per worker run — the durable
// record of what the engine actually did, including honest failures).
model RiisheAutomationRun {
  id           String           @id @default(cuid())
  automationId String
  automation   RiisheAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  // SUCCEEDED | FAILED
  status       String           @default("SUCCEEDED")
  // JSON result: what was prepared/observed (drafts, counts, matches).
  resultJson   String           @default("{}")
  error        String?
  createdAt    DateTime         @default(now())

  @@index([automationId, createdAt])
  @@index([userId, createdAt])
}

// User-authored PRIVATE notes about a person, owned strictly by the author.
// personId is a loose reference to a User row (no FK) so a note about someone
// who later deletes their account keeps the author's private history honest —
// the note never exposes the other user's data beyond what the author wrote.
model RiisheContactNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("riisheContactNotes", fields: [userId], references: [id], onDelete: Cascade)
  personId  String
  // Optional collaboration status the author assigns:
  // NEW | CONTACTED | IN_CONVERSATION | COLLABORATING | CLOSED
  status    String?
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, personId])
  @@index([userId, updatedAt])
}

// ---------- RIISHE advanced automation agent (additive) ----------
// Multi-step workflows planned from natural language: every plan and every
// step is a real persistent record with its own execution history. Steps run
// through the permission-aware tool registry (riishe.tools) on the durable
// BackgroundJob queue — the model NEVER executes anything by itself and a
// step only "succeeds" when its registered tool handler actually completed.
model RiisheWorkflow {
  id   String @id @default(cuid())
  userId String
  user User   @relation("riisheWorkflows", fields: [userId], references: [id], onDelete: Cascade)
  title  String
  // The user's original natural-language goal (verbatim, for auditability).
  goal   String
  // AWAITING_APPROVAL | ACTIVE | PAUSED | COMPLETED | FAILED | CANCELLED
  status String   @default("ACTIVE")
  // JSON { summary, planner: "llm" | "deterministic", createdAt }
  planJson String @default("{}")
  // Traceability: the AiConversation this workflow was planned from.
  conversationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps RiisheWorkflowStep[]

  @@index([userId, status])
  @@index([status, updatedAt])
}

// One persistent execution record per planned step. Dependent steps wait for
// their dependencies; HIGH/DESTRUCTIVE steps wait for explicit approval;
// scheduled steps wait for their time. Retries, timeouts, failures and
// results are all recorded here — never fabricated.
model RiisheWorkflowStep {
  id         String         @id @default(cuid())
  workflowId String
  workflow   RiisheWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation("riisheWorkflowSteps", fields: [userId], references: [id], onDelete: Cascade)
  // Display/execution order within the workflow (unique per workflow).
  seq        Int
  // Registered tool name (riishe.tools) — validated at plan time.
  kind       String
  title      String
  // The planner's symbolic id (s1, s2, ...) used for cross-step references
  // (draftRef / postRef params resolve through it at execution time).
  ref        String?
  // JSON tool input (validated against the tool's zod schema at plan time).
  paramsJson String   @default("{}")
  // JSON array of step ids this step depends on.
  dependsOnJson String @default("[]")
  // LOW | MEDIUM | HIGH | DESTRUCTIVE — copied from the tool registry,
  // never from the model output.
  risk       String   @default("LOW")
  requiresApproval Boolean @default(false)
  // PENDING | AWAITING_APPROVAL | READY | RUNNING | SUCCEEDED | FAILED | SKIPPED | CANCELLED
  status     String   @default("PENDING")
  resultJson String   @default("{}")
  error      String?
  attempts   Int      @default(0)
  maxAttempts Int     @default(3)
  timeoutMs  Int      @default(60000)
  // Future execution time for scheduled steps (null = run when ready).
  scheduledFor DateTime?
  backgroundJobId String?
  approvedAt DateTime?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, seq])
  @@index([workflowId, seq])
  @@index([workflowId, ref])
  @@index([userId, status])
  @@index([status, scheduledFor])
}

// Creators the account owner shortlisted (from discovery/workflow results).
// personId is a loose reference — shortlists survive the other account's
// deletion exactly like private notes do.
model RiisheCreatorShortlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("riisheShortlist", fields: [userId], references: [id], onDelete: Cascade)
  personId  String
  reason    String?
  source    String?
  createdAt DateTime @default(now())

  @@unique([userId, personId])
  @@index([userId, createdAt])
}

// RIISHE-specific, user-approved preferences (tone, defaults, quiet hours).
// Inspectable, editable and deletable through /api/riishe/preferences —
// nothing is stored silently and no conversation content is persisted here.
model RiisheUserPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("riishePreferences", fields: [userId], references: [id], onDelete: Cascade)
  key       String
  valueJson String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ============================================================================
// Portfolio studio (M22 restoration — models lost in the 2026-11-11 lineage
// reconstruction, rebuilt 2026-11-14 from the surviving code that references
// them: src/app/api/portfolio/*, src/app/api/site/[slug], src/lib/
// portfolio-server.ts, src/lib/portfolio-schema.ts). One portfolio per user;
// the public site is resolved by `slug` (/api/site/<slug>). `draft` and
// `published` hold the full JSON site config (src/lib/portfolio-schema.ts,
// capped at 200 000 bytes by MAX_CONFIG_BYTES) — `published` is the frozen
// copy promoted by /api/portfolio/publish and cleared by unpublish.
// ============================================================================
model Portfolio {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String    @unique // public address — 3-24 chars, lowercase/digits/hyphens (RESERVED_SLUGS guarded)
  templateId  String    @default("editorial")
  draft       String // current JSON config (source of truth for the studio)
  published   String? // frozen JSON config while published; null = unpublished
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  revisions PortfolioRevision[]

  @@index([updatedAt])
}

// Publish-time snapshot of Portfolio.draft ("Published <timestamp>" labels;
// retention keeps the newest 20 — see /api/portfolio/publish). Restores are
// always scoped by portfolioId, so foreign revision ids 404.
model PortfolioRevision {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  data        String // JSON config snapshot (validateConfig round-trips it)
  label       String?
  createdAt   DateTime  @default(now())

  @@index([portfolioId, createdAt])
}

// Site-studio design chat transcript (M22 restoration). One flat stream of
// USER/ASSISTANT rows grouped by a client-generated `conversationId` string
// (deliberately NOT a relation — ownership is enforced by the
// userId+conversationId pair on every query; there is no conversation table).
// `metaJson` carries assistant payload extras ({jobId, steps, mode} |
// {steps, clarifying} | {error}) and is only set on ASSISTANT rows.
// Persisted separately from RIISHE's AiConversation on purpose.
model DesignChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  role           String // "USER" | "ASSISTANT"
  content        String // user text <=2000 chars; assistant text <=8000 chars
  metaJson       String?
  createdAt      DateTime @default(now())

  @@index([userId, conversationId, createdAt])
}

// ---------- Opportunity Exchange (O1 — employer identity) ----------
// Employer organizations, memberships and verification: the additive O1 slice
// of the Opportunity Exchange program (docs/ops/O0_OPPORTUNITY_EXCHANGE_AUDIT.md
// §10.1, owner-approved 2026-11-16). No candidate-side entity exists yet (O2+).
// Status/role columns are UPPERCASE String "enums" validated with zod at the
// API boundary (SQLite has no native enums — house convention). Deletes never
// destroy hiring history: org deletion is not exposed in v1, and User-linked
// rows use SetNull/Cascade per the O0 audit's integrity rules.

/// An employer organization on BEAN Folio. The tenant root for every OX
/// employer resource — each employer query binds organizationId (O0 §5).
model EmployerOrganization {
  id                 String    @id @default(cuid())
  legalName          String
  displayName        String
  slug               String    @unique
  website            String?
  industry           String?
  companySize        String? // STARTUP_1_10 | SMB_11_50 | MID_51_200 | LARGE_201_1000 | ENTERPRISE_1000_PLUS
  description        String?
  headquarters       String?
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED | SUSPENDED
  verificationMethod String? // how the org became VERIFIED (set at approval, e.g. MANUAL_REVIEW)
  verifiedAt         DateTime?
  createdByUserId    String?
  createdBy          User?     @relation("employerOrgCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships   EmployerMembership[]
  verifications EmployerVerification[]
  opportunities Opportunity[]
  shortlists    CandidateShortlist[]

  @@index([verificationStatus])
}

/// One user's membership in one employer organization. Unique per (org, user)
/// — duplicate memberships are impossible by constraint; re-inviting a
/// REMOVED member reactivates the same row (status → INVITED), never a
/// second row (O1 owner directive: prevent duplicate organization
/// memberships).
model EmployerMembership {
  id              String    @id @default(cuid())
  organizationId  String
  userId          String
  role            String    @default("VIEWER") // OWNER | ADMIN | RECRUITER | HIRING_MANAGER | VIEWER
  status          String    @default("ACTIVE") // ACTIVE | INVITED | SUSPENDED | REMOVED
  invitedByUserId String? // inviting member's user id (display provenance; deliberately no FK — loose-ref house style)
  joinedAt        DateTime? // set when an INVITED member accepts
  createdAt       DateTime  @default(now())

  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation("employerMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// One verification review of one organization. `evidenceReference` holds a
/// SECURE REFERENCE ONLY (an external case/receipt identifier resolved by the
/// review tooling) — raw identity documents are never stored in this table or
/// anywhere in the Opportunity Exchange (O0 §5, owner directive O1 §3).
model EmployerVerification {
  id                String    @id @default(cuid())
  organizationId    String
  method            String    @default("MANUAL_REVIEW") // v1 pilot: MANUAL_REVIEW (O0 §11 D5)
  status            String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  evidenceReference String? // secure external reference — never document contents
  reviewerUserId    String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())

  organization EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer     User?                @relation("employerVerifications", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

/// One candidate opportunity profile per User — the candidate-side surface of
/// the Opportunity Exchange (O2). Creating a profile NEVER makes a candidate
/// discoverable: `visibilityStatus` defaults to HIDDEN, and `ACTIVE` requires
/// a current, purpose-scoped DISCOVERY consent grant enforced server-side on
/// every future read (O0 §6).
model CandidateOpportunityProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation("candidateOpportunityProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Visibility state machine (O0 §6.3). ACTIVE is the only consent-gated
  // state; PAUSED freezes existing matches; INVITE_ONLY restricts extended
  // info to approved organizations (enforced from O4 onward).
  visibilityStatus       String    @default("HIDDEN") // HIDDEN | ACTIVE | PAUSED | INVITE_ONLY

  // Preferences — JSON string arrays (SQLite house convention, `User.tools`
  // precedent); app-layer filtering is the documented v1 SQLite-scale
  // tradeoff (O0 §3). Vocabularies are zod-enforced at the boundary (src/lib/ox).
  employmentTypes        String? // JSON string[]: FULL_TIME | PART_TIME | CONTRACT | FREELANCE | INTERNSHIP
  workModes              String? // JSON string[]: ONSITE | HYBRID | REMOTE
  preferredLocations     String? // JSON string[] of free-text location labels (max 10 x 80 chars)
  preferredProfessionIds String? // JSON string[] of Profession.id — loose ref, existence-validated at the boundary

  experienceMinYears     Int? // 0-50, min <= max (zod-refined)
  experienceMaxYears     Int?
  availableFrom          DateTime?
  noticePeriodDays       Int? // 0-365

  // Salary privacy (O0 §11 D4): BigInt minor units (paise) + ISO 4217 currency +
  // explicit period. Defaults to HIDDEN and is serialized only per the
  // candidate's disclosure policy for the exact requesting context. Never
  // floating-point. BigInt storage (O2.1, defect O2-ACC-01): the approved
  // ceiling ₹10 crore = 10,000,000,000 paise exceeds Prisma Int's 32-bit
  // range (2,147,483,647), so accepted payloads in (2147483647, 10000000000]
  // corrupted rows. Stored values are native BigInt; the API JSON contract
  // stays numeric via the checked conversion in src/lib/ox/validation.ts
  // (bounds + Number.isSafeInteger before any number conversion).
  compensationVisibility String  @default("HIDDEN") // HIDDEN | VERIFIED_EMPLOYERS | AFTER_INVITE | RANGE_ONLY
  salaryMinPaise         BigInt? // 0 <= min <= max <= 10000000000
  salaryMaxPaise         BigInt?
  salaryCurrency         String? // ISO 4217 (^[A-Z]{3}$) — required when either salary bound is set
  compensationPeriod     String? // YEAR | MONTH | HOUR — required when either salary bound is set

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([visibilityStatus])
}

/// Purpose-scoped consent ledger (O2; O0 §6.1). Purposes are separate rows —
/// never one global boolean. Append-lifecycle history: one row per grant;
/// revocation updates that row in place (status REVOKED + revokedAt) and a
/// re-grant creates a NEW row, so no prior consent state is ever overwritten.
/// Current consent = the latest row per (user, scope); it is valid only while
/// status is GRANTED and (expiresAt is null or in the future). No row at all
/// also means no consent.
model CandidateVisibilityConsent {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("candidateVisibilityConsents", fields: [userId], references: [id], onDelete: Cascade)
  scope          String // DISCOVERY | PROFILE_ANALYTICS | AI_PROCESSING — independent purposes
  status         String // GRANTED | REVOKED — one row per grant lifecycle
  consentVersion String // server-owned vocabulary version recorded at grant time
  source         String // server-owned provenance (e.g. CANDIDATE_UI)
  grantedAt      DateTime  @default(now())
  revokedAt      DateTime?
  expiresAt      DateTime? // optional; an expired grant is not a current consent

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, scope, createdAt]) // current-consent lookup: latest row per (user, scope)
  @@index([userId, status])
}

/// One employer job opportunity (M-O3, additive). Lifecycle (approved owner
/// decisions): DRAFT → PENDING_REVIEW → PUBLISHED → PAUSED → FILLED | CLOSED.
/// Only an ADMIN review decision moves PENDING_REVIEW → PUBLISHED — a submit
/// never publishes directly. Any content edit of a PUBLISHED or PAUSED row
/// atomically returns it to PENDING_REVIEW (re-approval required). FILLED and
/// CLOSED are terminal. Illegal transitions are refused with 409 and ZERO
/// database writes. Deletion is audited and possible only in DRAFT.
model Opportunity {
  id              String   @id @default(cuid())
  organizationId  String
  organization    EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?    @relation("employerOpportunitiesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  title       String // 5-120 chars (zod-enforced)
  description String // 20-8000 chars (zod-enforced)
  status      String   @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | PAUSED | FILLED | CLOSED

  professionId   String? // existing Profession taxonomy — loose ref (O2 precedent), existence-validated at the boundary
  location       String? // free text, <= 120 chars
  employmentType String? // FULL_TIME | PART_TIME | CONTRACT | FREELANCE | INTERNSHIP
  workMode       String? // ONSITE | HYBRID | REMOTE
  positions      Int? // 1-100 when set

  // Salary — same contract as CandidateOpportunityProfile (O0 §11 D4 + O2.1):
  // BigInt paise via the single checked boundary (salaryPaiseToStorage /
  // salaryPaiseFromStorage in src/lib/ox/validation.ts), ISO 4217 currency,
  // explicit period. A complete salary range (min+max+currency+period) is
  // REQUIRED before submit and re-checked at admin approval. Never floats,
  // never clamped. Ceiling: ₹10 crore = 10,000,000,000 paise.
  salaryMinPaise     BigInt? // 0 <= min <= max <= 10000000000
  salaryMaxPaise     BigInt?
  salaryCurrency     String? // ISO 4217 (^[A-Z]{3}$) — required when a bound is set
  compensationPeriod String? // YEAR | MONTH | HOUR — required when a bound is set

  submittedAt       DateTime? // set at each submit, cleared on admin rejection
  publishedAt       DateTime? // set at each admin approval
  publishedByUserId String?   // admin who approved the latest publication
  publishedBy       User?     @relation("employerOpportunitiesPublished", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  closedAt          DateTime? // set when the row reaches FILLED or CLOSED
  rejectionReason   String?   // reason from the latest admin rejection (row returned to DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  skills OpportunitySkill[]
  talentMatches TalentMatch[]  @relation("talentMatches")
  shortlistedOpportunities CandidateShortlist[] @relation("shortlistedOpportunities")

  @@index([organizationId, status])
  @@index([status, updatedAt])
  @@index([createdByUserId])
}

/// One REQUIRED or PREFERRED skill attached to one opportunity (M-O3,
/// additive). References the EXISTING Skill taxonomy — no duplicate skill
/// identity is introduced (O0 §1). The compound primary key enforces
/// (opportunityId, skillId) uniqueness; duplicate rows are impossible by
/// constraint and duplicates inside one payload are refused with 400 before
/// any write. `kind` is explicit (REQUIRED | PREFERRED); approved caps:
/// REQUIRED <= 8, PREFERRED <= 12, total <= 20, minimum zero (the approved
/// decision table allows a listing with no skill chips).
model OpportunitySkill {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  kind          String // REQUIRED | PREFERRED (zod-enforced at the boundary)

  createdAt DateTime @default(now())

  @@id([opportunityId, skillId])
  @@index([skillId])
}

/// One CURRENT deterministic candidate↔opportunity compatibility record
/// (M-O4, additive). DERIVED DATA — never a hiring decision and never a
/// rejection record. A stored row NEVER grants visibility: every read path
/// re-checks consent + visibility + organization verification server-side
/// through the single discovery boundary (approved decisions D2/D9; queue
/// safeguard C — expiry cleanup only, never authorization). One current row
/// per (opportunityId, candidateUserId); recomputation UPDATES the current
/// row (D3) — no score history is retained.
///
/// Storage minimality (owner directive §3.1): identifiers, scoring metadata
/// and minimal factor/reason information ONLY — no copied candidate names,
/// email, phone, resumes, full profile data, salary values or skill-list
/// snapshots. `matchVersion` is metadata stamped on the current row, not a
/// mechanism for retaining historical score rows.
model TalentMatch {
  id               String      @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity @relation("talentMatches", fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateUserId  String
  candidate        User        @relation("talentMatches", fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// Server-owned scoring formula version ("O4-MATCH-V1").
  matchVersion     String
  /// 0-100 deterministic composite of the ACTIVE factors (rounded half-up,
  /// documented denominator) — an explanation aid, never a hiring
  /// probability and never a rejection record.
  score            Int
  /// True when Stage-1 eligibility passed; false rows carry a reason and are
  /// never shown to employers as matches.
  eligible         Boolean
  /// CONSENT_INVALID | VISIBILITY_NOT_DISCOVERABLE | BLOCK_EXISTS |
  /// EMPLOYMENT_TYPE_MISMATCH | COMPENSATION_MISMATCH — null when eligible.
  ineligibleReason String?
  /// Minimal per-factor explainability metadata (earned/max/applied/reason),
  /// audience-filtered at serialization. Never contains salary values,
  /// contact data or anything beyond the factor/reason vocabulary.
  explanationJson  String?
  /// When this row was computed (injected clock — the score function is
  /// pure and receives time as input).
  generatedAt      DateTime
  /// Staleness marker; the queue expiry sweep refreshes or removes stale
  /// rows (safeguard C) and stale rows are never served as current.
  expiresAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, candidateUserId])
  @@index([candidateUserId, matchVersion])
  @@index([opportunityId, score])
}

/// One employer-side shortlist entry (M-O5, additive). Per-opportunity and
/// tenant-bound: unique per (organizationId, opportunityId, candidateUserId)
/// — one entry per candidate per opportunity (approved decision D13). The
/// opportunityId always belongs to organizationId (validated on every write
/// at the API boundary). An entry is an employer WORKING RECORD — it does
/// NOT bypass consent: EVERY add and every read revalidates eligibility
/// through the single discovery boundary (approved decision D14), and
/// masked states are rendered truthfully when consent/visibility changed.
/// Storage minimality: identifiers, authorized status and minimal metadata
/// ONLY — no copied candidate name, email, phone, salary, resume, skills or
/// frozen candidate card (D14).
model CandidateShortlist {
  id                String      @id @default(cuid())
  organizationId    String
  organization      EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId     String
  opportunity       Opportunity @relation("shortlistedOpportunities", fields: [opportunityId], references: [id], onDelete: Cascade)
  candidateUserId   String
  candidate         User        @relation("shortlistedCandidates", fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// Employer-private recruiting note (<= 500 chars, zod-enforced).
  note              String?
  /// Match score snapshot at add time (explainability provenance only).
  scoreAtAdd        Int?
  /// Scoring formula version at add time.
  matchVersionAtAdd String?
  /// The ACTIVE member who added the entry (provenance; SetNull on deletion).
  addedByUserId     String?
  addedBy           User?       @relation("shortlistsAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  /// ACTIVE | ARCHIVED — archive keeps the record without deleting history.
  status            String      @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, opportunityId, candidateUserId])
  @@index([organizationId, status])
  @@index([candidateUserId])
}
