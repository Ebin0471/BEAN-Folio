# BEAN Folio — Docker build context guard.
#
# `COPY . .` in the builder stage must receive SOURCE ONLY. Everything on the
# host that is runtime data, local state, developer scratch space, or
# version-control metadata is excluded here so that:
#   - build context stays small (the repo carries ~1.3 GB of node_modules and
#     hundreds of MB of runtime artifacts that must never enter an image layer),
#   - no secret-bearing file (.env*, .git/bean-auth vault, PEM keys) can leak
#     into the builder,
#   - builds are reproducible regardless of what the working machine happens
#     to carry on disk.
#
# Everything NOT listed here is sent to the builder — when you add a new
# top-level runtime artifact directory, exclude it here too.

# Version control + CI metadata
.git
.github

# Dependency trees (installed fresh inside the builder via bun.lock)
node_modules
**/node_modules

# Build outputs (rebuilt inside the builder)
.next
**/.next
next-env.d.ts
tsconfig.tsbuildinfo

# Runtime data — NEVER enters an image (runtime-data scan policy)
db
*.db
*.db-journal
*.db-wal
uploads
data
backups
tool-results
logs

# Secrets and local configuration
.env
.env.*
!.env.example

# Developer scratch space, screenshots, docs and load-test evidence
agent-ctx
docs
tests
*.log
dev.log
server.log
prisma/db

# OS / editor noise
.DS_Store
Thumbs.db
.idea
.vscode
