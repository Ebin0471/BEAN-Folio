# BEAN Folio — production Compose environment template.
#
# Copy to `.env.compose` (gitignored) and fill REAL values you generate
# yourself. This file carries PLACEHOLDERS ONLY — never commit the filled
# copy, never bake secrets into images.
#
#   cp .env.compose.example .env.compose
#   # generate a strong password, e.g.:
#   #   openssl rand -base64 32   (Linux/macOS)
#   #   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))   (PowerShell)
#   docker compose --env-file .env.compose up -d --build

# ── Required ────────────────────────────────────────────────────────────────
# Postgres superuser password for the `db` service (generate your own).
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Public origin users reach (drives absolute URLs baked into client bundles).
# Must match the Caddy domain exactly (scheme included).
NEXT_PUBLIC_APP_URL=https://bean.example.com

# Domain Caddy serves + obtains Let's Encrypt certificates for (no scheme).
BEAN_DOMAIN=bean.example.com

# ── Optional ────────────────────────────────────────────────────────────────
# Structured log level: debug | info (default) | warn | error
LOG_LEVEL=info

# Operator webhook for error alarms (reportError → POST). Leave empty to disable.
ERROR_WEBHOOK_URL=

# Bearer token required by GET /api/metrics (Prometheus scraping).
# Generate your own, e.g. `openssl rand -hex 24`. Empty = open (dev only).
METRICS_TOKEN=

# Optional: S3-compatible object storage for media (all-or-nothing — partial
# configuration refuses to start in production). When unset, media persists on
# the `media` Docker volume (single-host tier).
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=beanfolio-media
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# MEDIA_STORAGE_DRIVER=s3
